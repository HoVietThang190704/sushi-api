generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "catalog"]
}

// ==========================================
// SCHEMA: identity
// ==========================================

enum UserRole {
  SUPER_ADMIN
  BRANCH_MANAGER
  CASHIER
  KITCHEN_STAFF
  CUSTOMER

  @@schema("identity")
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String         @map("password_hash")
  fullName     String         @map("full_name")
  role         UserRole       @default(CUSTOMER)
  branchId     String?        @map("branch_id") @db.Uuid
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@map("users")
  @@schema("identity")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
  @@schema("identity")
}

// ==========================================
// SCHEMA: catalog
// ==========================================

enum ProductType {
  SINGLE
  COMBO

  @@schema("catalog")
}

model ProductCategory {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @db.VarChar(100)
  parentId  String?           @map("parent_id") @db.Uuid
  parent    ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryHierarchy")
  products  Product[]

  @@map("product_categories")
  @@schema("catalog")
}

model Product {
  id           String           @id @default(uuid()) @db.Uuid
  sku          String           @unique @db.VarChar(60)
  barcode      String?          @db.VarChar(100)
  name         String           @db.VarChar(160)
  type         ProductType      @default(SINGLE)
  categoryId   String?          @map("category_id") @db.Uuid
  category     ProductCategory? @relation(fields: [categoryId], references: [id])
  sellingPrice Decimal          @map("selling_price") @db.Decimal(18, 2)
  imageUrl     String?          @map("image_url") @db.Text
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  comboItemsAsParent ComboItem[] @relation("ComboParent")
  comboItemsAsChild  ComboItem[] @relation("ComboChild")

  @@map("products")
  @@schema("catalog")
}

model ComboItem {
  comboId        String  @map("combo_id") @db.Uuid
  childProductId String  @map("child_product_id") @db.Uuid
  quantity       Decimal @db.Decimal(12, 3)

  combo        Product @relation("ComboParent", fields: [comboId], references: [id], onDelete: Cascade)
  childProduct Product @relation("ComboChild", fields: [childProductId], references: [id], onDelete: Cascade)

  @@id([comboId, childProductId])
  @@map("combo_items")
  @@schema("catalog")
}
