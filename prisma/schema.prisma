generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "catalog", "inventory", "ordering"]
}

// ==========================================
// SCHEMA: identity
// ==========================================

enum UserRole {
  SUPER_ADMIN
  BRANCH_MANAGER
  CASHIER
  KITCHEN_STAFF
  CUSTOMER

  @@schema("identity")
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String         @map("password_hash")
  fullName     String         @map("full_name")
  role         UserRole       @default(CUSTOMER)
  branchId     String?        @map("branch_id") @db.Uuid
  isActive     Boolean        @default(true) @map("is_active")
  phone              String?   @db.VarChar(30)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  tokenVersion       Int       @default(0) @map("token_version")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@index([branchId, role])
  @@map("users")
  @@schema("identity")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  action       String   @db.VarChar(60)
  targetUserId String?  @map("target_user_id") @db.Uuid
  before       Json?
  after        Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
  @@schema("identity")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
  @@schema("identity")
}

// ==========================================
// SCHEMA: catalog
// ==========================================

enum ProductType {
  SINGLE
  COMBO

  @@schema("catalog")
}

model ProductCategory {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @db.VarChar(100)
  parentId  String?           @map("parent_id") @db.Uuid
  parent    ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryHierarchy")
  products  Product[]

  @@map("product_categories")
  @@schema("catalog")
}

model Product {
  id           String           @id @default(uuid()) @db.Uuid
  sku          String           @unique @db.VarChar(60)
  slug         String?          @unique @db.VarChar(180)
  barcode      String?          @db.VarChar(100)
  name         String           @db.VarChar(160)
  type         ProductType      @default(SINGLE)
  categoryId   String?          @map("category_id") @db.Uuid
  category     ProductCategory? @relation(fields: [categoryId], references: [id])
  sellingPrice Decimal          @map("selling_price") @db.Decimal(18, 2)
  imageUrl     String?          @map("image_url") @db.Text
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  comboItemsAsParent ComboItem[] @relation("ComboParent")
  comboItemsAsChild  ComboItem[] @relation("ComboChild")
  recipe             Recipe?

  @@map("products")
  @@schema("catalog")
}

model ComboItem {
  comboId        String  @map("combo_id") @db.Uuid
  childProductId String  @map("child_product_id") @db.Uuid
  quantity       Decimal @db.Decimal(12, 3)

  combo        Product @relation("ComboParent", fields: [comboId], references: [id], onDelete: Cascade)
  childProduct Product @relation("ComboChild", fields: [childProductId], references: [id], onDelete: Cascade)

  @@id([comboId, childProductId])
  @@map("combo_items")
  @@schema("catalog")
}

// ==========================================
// SCHEMA: inventory
// ==========================================

enum TransactionType {
  IN
  OUT

  @@schema("inventory")
}

enum TransactionReason {
  INITIAL_STOCK
  PURCHASE
  KITCHEN_USAGE
  DISCARD_WASTE
  ADJUSTMENT

  @@schema("inventory")
}

model Ingredient {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(160)
  unit         String   @db.VarChar(30)
  currentStock Decimal  @default(0) @map("current_stock") @db.Decimal(18, 3)
  minStock     Decimal  @default(0) @map("min_stock") @db.Decimal(18, 3)
  costPrice    Decimal  @default(0) @map("cost_price") @db.Decimal(18, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  transactions    InventoryTransaction[]
  warehouseStocks WarehouseStock[]
  recipeItems     RecipeItem[]

  @@map("ingredients")
  @@schema("inventory")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(160)
  address   String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches     Branch[]
  stocks       WarehouseStock[]
  transactions InventoryTransaction[]
  deductions   OrderRecipeDeduction[]

  @@map("warehouses")
  @@schema("inventory")
}

model WarehouseStock {
  id           String     @id @default(uuid()) @db.Uuid
  warehouseId  String     @map("warehouse_id") @db.Uuid
  warehouse    Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  ingredientId String     @map("ingredient_id") @db.Uuid
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  currentStock Decimal    @default(0) @map("current_stock") @db.Decimal(18, 3)
  minStock     Decimal    @default(0) @map("min_stock") @db.Decimal(18, 3)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([warehouseId, ingredientId])
  @@index([warehouseId])
  @@index([ingredientId])
  @@map("warehouse_stocks")
  @@schema("inventory")
}

model Recipe {
  id        String       @id @default(uuid()) @db.Uuid
  productId String       @unique @map("product_id") @db.Uuid
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  notes     String?      @db.Text
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  items RecipeItem[]

  @@map("recipes")
  @@schema("inventory")
}

model RecipeItem {
  id           String     @id @default(uuid()) @db.Uuid
  recipeId     String     @map("recipe_id") @db.Uuid
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String     @map("ingredient_id") @db.Uuid
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Decimal    @db.Decimal(18, 3)

  @@unique([recipeId, ingredientId])
  @@map("recipe_items")
  @@schema("inventory")
}

model OrderRecipeDeduction {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @unique @map("order_id") @db.Uuid
  orderCode   String    @map("order_code") @db.VarChar(50)
  warehouseId String    @map("warehouse_id") @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("order_recipe_deductions")
  @@schema("inventory")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED

  @@schema("inventory")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(60)
  aggregateId   String       @map("aggregate_id") @db.VarChar(100)
  eventType     String       @map("event_type") @db.VarChar(100)
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  lastError     String?      @map("last_error") @db.Text
  claimedBy     String?      @map("claimed_by") @db.VarChar(100)
  claimedUntil  DateTime?    @map("claimed_until")
  nextAttemptAt DateTime?    @map("next_attempt_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  publishedAt   DateTime?    @map("published_at")

  @@index([status, createdAt])
  @@index([status, nextAttemptAt, createdAt])
  @@map("outbox_events")
  @@schema("inventory")
}

model InventoryTransaction {
  id           String            @id @default(uuid()) @db.Uuid
  code         String            @unique @db.VarChar(50)
  type         TransactionType
  reason       TransactionReason @default(PURCHASE)
  warehouseId  String?           @map("warehouse_id") @db.Uuid
  warehouse    Warehouse?        @relation(fields: [warehouseId], references: [id])
  orderId      String?           @map("order_id") @db.Uuid
  ingredientId String            @map("ingredient_id") @db.Uuid
  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id])
  quantity     Decimal           @db.Decimal(18, 3)
  unitPrice    Decimal           @default(0) @map("unit_price") @db.Decimal(18, 2)
  totalAmount  Decimal           @default(0) @map("total_amount") @db.Decimal(18, 2)
  note         String?           @db.Text
  createdBy    String?           @map("created_by")
  createdAt    DateTime          @default(now()) @map("created_at")

  @@map("inventory_transactions")
  @@schema("inventory")
}

// ==========================================
// SCHEMA: ordering
// ==========================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  DELIVERING
  COMPLETED
  CANCELLED

  @@schema("ordering")
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED

  @@schema("ordering")
}

model Branch {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(50)
  name        String     @db.VarChar(160)
  address     String     @db.Text
  phone       String     @db.VarChar(30)
  warehouseId String?    @map("warehouse_id") @db.Uuid
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  orders        Order[]
  shippingRules ShippingRule[]

  @@map("branches")
  @@schema("ordering")
}

model ShippingRule {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  province  String   @default("TP. Hồ Chí Minh") @db.VarChar(100)
  district  String   @db.VarChar(100)
  ward      String   @db.VarChar(100)
  fee       Decimal  @default(0) @db.Decimal(18, 2)
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([branchId, district, ward])
  @@index([district, ward, isActive])
  @@map("shipping_rules")
  @@schema("ordering")
}

model Order {
  id               String        @id @default(uuid()) @db.Uuid
  code             String        @unique @db.VarChar(50)
  branchId         String        @map("branch_id") @db.Uuid
  branch           Branch?       @relation(fields: [branchId], references: [id])
  customerName     String        @map("customer_name") @db.VarChar(120)
  customerPhone    String        @map("customer_phone") @db.VarChar(30)
  customerEmail    String?       @map("customer_email") @db.VarChar(255)
  address          String?       @db.Text
  province         String?       @db.VarChar(100)
  district         String?       @db.VarChar(100)
  ward             String?       @db.VarChar(100)
  note             String?       @db.Text
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(UNPAID) @map("payment_status")
  paymentMethod    String        @default("CASH") @map("payment_method") @db.VarChar(30)
  source           String        @default("STOREFRONT") @db.VarChar(20)
  shippingFee      Decimal       @default(0) @map("shipping_fee") @db.Decimal(18, 2)
  totalAmount      Decimal       @map("total_amount") @db.Decimal(18, 2)
  paymentQrUrl     String?       @map("payment_qr_url") @db.Text
  paymentBankInfo  String?       @map("payment_bank_info") @db.Text
  idempotencyKey         String?       @unique @map("idempotency_key") @db.VarChar(100)
  idempotencyFingerprint String?       @map("idempotency_fingerprint") @db.VarChar(64)
  accessTokenHash        String        @map("access_token_hash") @db.VarChar(64)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  items            OrderItem[]
  statusHistories  OrderStatusHistory[]

  @@index([customerPhone])
  @@index([status, createdAt])
  @@map("orders")
  @@schema("ordering")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String   @map("product_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(160)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(18, 2)
  quantity    Int
  subtotal    Decimal  @db.Decimal(18, 2)

  @@map("order_items")
  @@schema("ordering")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  reason     String?      @db.Text
  changedBy  String       @default("SYSTEM") @map("changed_by")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@map("order_status_histories")
  @@schema("ordering")
}

model PaymentConfig {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @unique @default("DEFAULT") @db.VarChar(50)
  bankName       String?  @map("bank_name") @db.VarChar(120)
  accountNumber  String?  @map("account_number") @db.VarChar(60)
  accountHolder  String?  @map("account_holder") @db.VarChar(120)
  qrImageUrl     String?  @map("qr_image_url") @db.Text
  transferSyntax String?  @default("HANBI") @map("transfer_syntax") @db.VarChar(50)
  note           String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("payment_configs")
  @@schema("ordering")
}

model StoreConfig {
  id                      String   @id @default(uuid()) @db.Uuid
  key                     String   @unique @default("DEFAULT") @db.VarChar(50)
  customerOrderingEnabled Boolean  @default(true) @map("customer_ordering_enabled")
  contactPhone            String   @default("0988888888") @map("contact_phone") @db.VarChar(30)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("store_configs")
  @@schema("ordering")
}
